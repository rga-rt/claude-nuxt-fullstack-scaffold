{
  "name": "claude-nuxt-i18n-sqlite-example",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "type-check": "nuxi typecheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "db:push": "mkdir -p data && drizzle-kit push:sqlite",
    "db:studio": "drizzle-kit studio",
    "db:seed": "mkdir -p data && tsx ./server/db/seed.ts"
  },
  "dependencies": {
    "nuxt": "^3.12.0",
    "@nuxt/devtools": "latest",
    "@nuxtjs/tailwindcss": "^6.11.0",
    "@nuxtjs/i18n": "^9.5.0",
    "drizzle-orm": "^0.30.0",
    "better-sqlite3": "^12.2.0"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^3.9.0",
    "@vue/test-utils": "^2.4.3",
    "@vitest/ui": "^3.2.0",
    "vitest": "^3.2.0",
    "happy-dom": "^13.3.8",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.19.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "drizzle-kit": "^0.20.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}
